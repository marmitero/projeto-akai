# Default client remains a local profile; choose online explicitly for API-backed play.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
VITE_GAME_MODE=local
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Development only: docker compose up -d db, then npm run db:migrate -w @akai/server
# DATABASE_URL=postgres://akai:akai_dev_only@127.0.0.1:5432/akai
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Tests must use an isolated DB; never point at a live player database.
# TEST_DATABASE_URL=postgres://akai:akai_dev_only@127.0.0.1:5432/akai_test
