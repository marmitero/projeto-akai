# Default client remains a local profile; choose online explicitly for API-backed play.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
VITE_GAME_MODE=local
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Development only: docker compose up -d db, then npm run db:migrate -w @akai/server
# DATABASE_URL=postgres://akai:akai_dev_only@127.0.0.1:5432/akai
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Tests must use an isolated DB; never point at a live player database.
# TEST_DATABASE_URL=postgres://akai:akai_dev_only@127.0.0.1:5432/akai_test

# Monetization OFF by default. Test modes require a SEPARATE, disposable database.
MONETIZATION_MODE=off
MONETIZATION_TEST_DATABASE=false
# Only for isolated test server, never NODE_ENV=production or public host/origin:
# MONETIZATION_MODE=sandbox
# MONETIZATION_TEST_DATABASE=true
# MONETIZATION_KEY=<64 random lowercase hex characters; never commit>
# Optional Google Play license-test backend (requires native checkout in F9):
# MONETIZATION_MODE=google-play-test
# PLAY_PACKAGE_NAME=com.example.akai
# PLAY_SERVICE_ACCOUNT_FILE=/private/path/service-account.json
