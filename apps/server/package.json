{
  "name": "@akai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "db:reconcile": "node --env-file-if-exists=../../.env --import tsx src/reconcile.ts",
    "community:admin": "node --env-file-if-exists=../../.env --import tsx src/community-admin.ts"
  },
  "dependencies": {
    "@akai/shared": "0.1.0",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.0.0"
  }
}
