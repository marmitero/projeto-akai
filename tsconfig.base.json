{
  "compilerOptions": {
    "target": "ES2022", "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true
  }
}
